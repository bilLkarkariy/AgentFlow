# syntax=docker/dockerfile:1.7
#
# AgentFlow Studio SPA. Build context = repository root:
#   docker build -f web/studio/Dockerfile -t agentflow-studio:local .
#
# Configuration is read at RUNTIME from /config.js (window.__APP_CONFIG__), generated by
# /docker-entrypoint.d/40-runtime-config.sh from the APP_* environment variables, so the
# same image is promoted from local to AWS without a rebuild.

# ---------------------------------------------------------------------------
# Stage 1 - build the static bundle (always on the native builder arch)
# ---------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM node:20-bookworm-slim AS build

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    HUSKY=0 \
    CI=true
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

WORKDIR /repo

# Workspace manifests first: the dependency layer is cached until they change.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.json ./
COPY api/package.json api/package.json
COPY web/dashboard/package.json web/dashboard/package.json
COPY web/studio/package.json web/studio/package.json

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter studio...

COPY web/studio web/studio

RUN pnpm --filter studio run build

# ---------------------------------------------------------------------------
# Stage 2 - runtime (nginx as uid 101 on port 8080, read-only rootfs friendly)
# ---------------------------------------------------------------------------
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
# Pick up Alpine security fixes newer than the base tag (openssl and friends).
USER root
RUN apk upgrade --no-cache

# Pre-rendered config: the stock 20-envsubst-on-templates.sh silently skips rendering when
# /etc/nginx/conf.d is not writable (read-only rootfs), so the server block must already be
# in place. The template copy keeps the standard envsubst flow available when it is - and
# that flow rewrites conf.d/default.conf as uid 101, hence the --chown.
COPY --chown=101:0 --chmod=0644 web/nginx/default.conf.template /etc/nginx/conf.d/default.conf
COPY --chown=101:0 --chmod=0644 web/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --chown=101:0 --chmod=0755 web/nginx/40-runtime-config.sh /docker-entrypoint.d/40-runtime-config.sh

COPY --from=build /repo/web/studio/dist /usr/share/nginx/html

USER 101

# NGINX_ENVSUBST_FILTER keeps envsubst away from nginx's own $uri / $host variables.
ENV APP_API_BASE_URL=http://localhost:3000 \
    NGINX_ENVSUBST_FILTER=^APP_

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
