{
  "name": "@agentflow/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --preserveWatchOutput --watch",
    "build": "nest build",
    "lint": "eslint --ext .js,.ts src",
    "test": "jest --detectOpenHandles --config jest-e2e.json",
    "test:watch": "jest --watch --detectOpenHandles --config jest-e2e.json",
    "test:e2e": "jest --detectOpenHandles --config jest-e2e.json --passWithNoTests",
    "test:unit": "jest --config jest.config.unit.json",
    "typeorm": "typeorm-ts-node-commonjs -d src/data-source.ts",
    "migration:generate": "pnpm typeorm migration:generate",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "migration:run:prod": "typeorm migration:run -d dist/src/data-source.js"
  },
  "dependencies": {
