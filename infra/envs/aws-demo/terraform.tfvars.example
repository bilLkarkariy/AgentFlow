########################################################################
# infra/envs/aws-demo - example overrides.
#
# Copy to terraform.tfvars ONLY if you need to deviate. Every variable
# has a working default, `make aws-up` passes nothing, and the defaults
# are what the cost table in README.md is based on.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# NOTE: terraform.tfvars is NOT gitignored today. Nothing secret belongs
# in it (there is no credential input in this stack), but keep it that
# way: passwords are generated by `random_password` and stored in Secrets
# Manager, never in a tfvars file.
########################################################################

# ---------------------------------------------------------------------
# Placement
# ---------------------------------------------------------------------
# region = "eu-west-1"

# Pinned by deploy/versions.yaml (kubernetes.eks_version). Only set this
# to test an upgrade without touching the local kind environment.
# kubernetes_version = "1.34"

# ---------------------------------------------------------------------
# Compute
# ---------------------------------------------------------------------
# THE ONE TO CHANGE when `aws-up` dies with
# "InsufficientInstanceCapacity" or "There is no Spot capacity available":
# capacity_type = "ON_DEMAND"     # ~0.13 USD/h more for two nodes

# node_arch           = "arm64"
# node_instance_types = ["t4g.large", "m6g.large", "m7g.large"]
# node_min_size       = 2
# node_max_size       = 3
# node_desired_size   = 2

# x86 fallback, if an image ever fails to build for arm64:
# node_arch           = "amd64"
# node_instance_types = ["t3a.large", "t3.large", "m6a.large"]

# ---------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------
# Strongly recommended for anything that outlives a demo. Find your IP
# with `curl -s https://checkip.amazonaws.com`.
# api_allowed_cidrs = ["203.0.113.42/32"]

# The GitHub Actions OIDC role created by the bootstrap stack, so that
# .github/workflows/aws-up.yml can talk to the cluster.
# extra_admin_role_arns = ["arn:aws:iam::123456789012:role/agentflow-github-actions"]

# ---------------------------------------------------------------------
# GitOps
# ---------------------------------------------------------------------
# gitops_repo_url = "https://github.com/bilLkarkariy/AgentFlow.git"
# gitops_revision = "platform"    # demo a branch before merging to main
# profile         = "minimal"     # core mesh + control plane only

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
# db_instance_class = "db.t4g.micro"
# db_engine_version = "16"
# db_force_ssl      = true        # false only to debug a TLS problem

# ---------------------------------------------------------------------
# Tagging
# ---------------------------------------------------------------------
# Merged on top of Project/Env/ManagedBy/Stack. Do not remove those four:
# scripts/aws-check-clean.sh finds leftovers by Stack=aws-demo.
# tags = { Owner = "billel" }
